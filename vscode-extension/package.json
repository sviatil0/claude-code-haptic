{
  "name": "claude-code-haptic",
  "displayName": "Claude Code Haptic",
  "description": "Trackpad haptic feedback + sound notification when Claude Code needs your input or finishes responding.",
  "version": "0.3.1",
  "publisher": "sviatil0",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sviatil0/claude-code-haptic.git"
  },
  "bugs": {
    "url": "https://github.com/sviatil0/claude-code-haptic/issues"
  },
  "homepage": "https://github.com/sviatil0/claude-code-haptic#readme",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "keywords": ["claude", "claude-code", "haptic", "notification", "macos", "vibration", "sound"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeHaptic.install",
        "title": "Claude Code Haptic: Install hooks into ~/.claude/settings.json"
      },
      {
        "command": "claudeCodeHaptic.uninstall",
        "title": "Claude Code Haptic: Remove hooks from ~/.claude/settings.json"
      },
      {
        "command": "claudeCodeHaptic.test",
        "title": "Claude Code Haptic: Test buzz + sound"
      },
      {
        "command": "claudeCodeHaptic.installBackend",
        "title": "Claude Code Haptic: Install mactic backend (Homebrew)"
      },
      {
        "command": "claudeCodeHaptic.openSettings",
        "title": "Claude Code Haptic: Open settings"
      },
      {
        "command": "claudeCodeHaptic.pickSession",
        "title": "Claude Code Haptic: Focus a Claude session window"
      },
      {
        "command": "claudeCodeHaptic.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeCodeHaptic.clearFinished",
        "title": "Clear finished sessions",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCodeHaptic.resumeSession",
        "title": "Focus & dismiss",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeHaptic",
          "title": "Claude Sessions",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "claudeCodeHaptic": [
        {
          "id": "claudeCodeHapticSessions",
          "name": "Claude Sessions",
          "contextualTitle": "Claude Code Haptic"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeHaptic.refreshSessions",
          "when": "view == claudeCodeHapticSessions",
          "group": "navigation"
        },
        {
          "command": "claudeCodeHaptic.clearFinished",
          "when": "view == claudeCodeHapticSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeHaptic.resumeSession",
          "when": "view == claudeCodeHapticSessions",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Haptic",
      "properties": {
        "claudeCodeHaptic.mode": {
          "type": "string",
          "default": "both",
          "enum": ["sound", "vibration", "both", "off"],
          "description": "What fires on Claude events: sound, trackpad vibration, both, or off."
        },
        "claudeCodeHaptic.trackSessions": {
          "type": "boolean",
          "default": true,
          "description": "Record each Claude session's status into ~/.claude/haptic-sessions.json so the Claude Sessions panel can list waiting/finished sessions. Re-run 'Install hooks' after changing."
        },
        "claudeCodeHaptic.notificationSound": {
          "type": "string",
          "default": "Frog",
          "enum": ["Basso", "Blow", "Bottle", "Frog", "Funk", "Glass", "Hero", "Morse", "Ping", "Pop", "Purr", "Sosumi", "Submarine", "Tink", "none"],
          "description": "Sound played when Claude needs input."
        },
        "claudeCodeHaptic.stopSound": {
          "type": "string",
          "default": "Hero",
          "enum": ["Basso", "Blow", "Bottle", "Frog", "Funk", "Glass", "Hero", "Morse", "Ping", "Pop", "Purr", "Sosumi", "Submarine", "Tink", "none"],
          "description": "Sound played when Claude finishes responding."
        },
        "claudeCodeHaptic.soundVolume": {
          "type": "number",
          "default": 1.0,
          "minimum": 0,
          "maximum": 5,
          "description": "Sound volume (afplay -v). 0=silent, 1=normal, up to 5=amplified."
        },
        "claudeCodeHaptic.haptic": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "mactic", "nshaptic", "off"],
          "description": "Haptic backend. 'auto' = mactic if installed else nshaptic .app fallback."
        },
        "claudeCodeHaptic.hapticPulses": {
          "type": "number",
          "default": 5,
          "description": "Number of haptic pulses per event (mactic -r)."
        },
        "claudeCodeHaptic.hapticWaveform": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "mactic waveform ID (1=weak click, 6=strong tap, max strength)."
        },
        "claudeCodeHaptic.hapticIntervalMs": {
          "type": "number",
          "default": 50,
          "description": "Milliseconds between pulses (mactic -i)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
